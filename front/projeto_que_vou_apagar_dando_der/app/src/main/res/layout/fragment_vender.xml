<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Header Vender -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_red_header"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_vender"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_add_circle"
            app:tint="@color/white"
            android:contentDescription="@string/seller_new_product"
            android:id="@+id/add_product"
            android:clickable="true"
            android:focusable="true"
            android:enabled="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/seller_list_title"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/all_sellers"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/seller_directory_all" />
        <TextView android:id="@+id/directory_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:visibility="gone" android:text="@string/seller_directory_retry" />
        <ProgressBar android:id="@+id/directory_progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/sellers_list" android:layout_width="match_parent"
            android:layout_height="200dp" android:visibility="gone" />
    </LinearLayout>

    <HorizontalScrollView android:id="@+id/product_filters" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/model_filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_model" app:cornerRadius="24dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/category_filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/filter_category" app:cornerRadius="24dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/piece_filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/filter_piece" app:cornerRadius="24dp" />
        <ImageButton android:id="@+id/btn_chat_vender" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_chat" android:background="?attr/selectableItemBackgroundBorderless" app:tint="?attr/colorOnSurface" android:contentDescription="@string/title_usuarios" />
    </LinearLayout></HorizontalScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3"
                android:text="@string/seller_table_title" android:textColor="?attr/colorOnSurface" android:gravity="center_vertical" />
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/colorOutlineVariant" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:text="@string/seller_requests" android:textColor="?attr/colorOnSurface" android:gravity="center" android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/seller_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_margin="16dp" />
        <TextView android:id="@+id/seller_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp" android:gravity="center" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/retry_button"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:text="@string/feed_retry" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/products_list"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
