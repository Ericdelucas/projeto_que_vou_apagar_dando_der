<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Header Vender -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_red_header"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_vender"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_add_circle"
            app:tint="@color/white"
            android:contentDescription="@string/seller_new_product"
            android:id="@+id/add_product"
            android:clickable="true"
            android:focusable="true"
            android:enabled="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/seller_list_title"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/all_sellers"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/seller_directory_all" />
        <TextView android:id="@+id/directory_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:visibility="gone" android:text="@string/seller_directory_retry" />
        <ProgressBar android:id="@+id/directory_progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/sellers_list" android:layout_width="match_parent"
            android:layout_height="200dp" android:visibility="gone" />
    </LinearLayout>

    <!-- Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <LinearLayout android:id="@+id/model_filter" android:clickable="true" android:focusable="true" android:enabled="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_red_pill"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="6dp">

            <TextView android:id="@+id/model_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tipage_modelo"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/white"
                android:contentDescription="Dropdown" />
        </LinearLayout>

        <LinearLayout android:id="@+id/category_filter" android:clickable="true" android:focusable="true" android:enabled="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_red_pill"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/category_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/categoria_ano"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/white"
                android:contentDescription="Dropdown" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_chat_vender"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_chat"
            app:tint="@color/black"
            android:contentDescription="Chat" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_border" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3"
                android:text="@string/seller_table_title" android:textColor="@color/black" android:gravity="center_vertical" />
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/black" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:text="@string/seller_requests" android:textColor="@color/black" android:gravity="center" android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/seller_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_margin="16dp" />
        <TextView android:id="@+id/seller_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp" android:gravity="center" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/retry_button"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:text="@string/feed_retry" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/products_list"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
