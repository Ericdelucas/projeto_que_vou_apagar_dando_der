<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <EditText android:id="@+id/title_input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/seller_title" android:inputType="textCapSentences" android:maxLength="255" />
        <EditText android:id="@+id/price_input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/seller_price" android:inputType="numberDecimal" />
        <EditText android:id="@+id/category_input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/seller_category" android:inputType="textCapSentences" android:maxLength="255" />
        <EditText android:id="@+id/model_input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/seller_model" android:inputType="textCapWords" android:maxLength="255" />
        <EditText android:id="@+id/image_input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/seller_image_url" android:inputType="textUri" android:maxLength="2048" />
        <EditText android:id="@+id/video_input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/seller_video_url" android:inputType="textUri" android:maxLength="2048" />
        <EditText android:id="@+id/location_input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/seller_location" android:inputType="textCapWords" android:maxLength="255" />
        <ProgressBar android:id="@+id/saving_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:visibility="gone" />
        <TextView android:id="@+id/error_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
