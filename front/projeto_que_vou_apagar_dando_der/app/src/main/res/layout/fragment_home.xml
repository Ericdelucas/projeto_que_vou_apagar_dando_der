<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Top Red Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_red_header"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <EditText android:id="@+id/feed_search" android:inputType="text" android:imeOptions="actionSearch" android:autofillHints="" android:background="@android:color/transparent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/feed_search_hint"
                android:textColor="@color/white"
                    android:textColorHint="#EEEEEE"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white"
                android:contentDescription="Search" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_notifications"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_notifications"
            app:tint="@color/white"
            android:contentDescription="Notifications" />
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/model_filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_model" app:cornerRadius="24dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/category_filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/filter_category" app:cornerRadius="24dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/tag_filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/filter_piece" app:cornerRadius="24dp" />
            <ImageButton android:id="@+id/btn_chat_home" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_chat" android:background="?attr/selectableItemBackgroundBorderless" app:tint="?attr/colorOnSurface" android:contentDescription="@string/title_usuarios" />
        </LinearLayout>
    </HorizontalScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <ProgressBar
        android:id="@+id/feed_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="16dp" />

    <TextView
        android:id="@+id/feed_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retry_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/feed_retry"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/feed_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />
</LinearLayout>
