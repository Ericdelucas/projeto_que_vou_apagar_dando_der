<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorSurface" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/blocked_back" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back" android:contentDescription="@string/settings_cancel"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/bloqueados" android:textSize="22sp" android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>
    <Button android:id="@+id/block_user_button" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/settings_block" />
    <ProgressBar android:id="@+id/blocked_progress" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
    <TextView android:id="@+id/blocked_message" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="16dp" android:gravity="center" android:visibility="gone" />
    <Button android:id="@+id/blocked_retry" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
        android:text="@string/feed_retry" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/blocked_list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
