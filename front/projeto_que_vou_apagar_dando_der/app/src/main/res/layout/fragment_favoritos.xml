<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/favoritos_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header Background -->
    <View
        android:id="@+id/header_background_favoritos"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_red_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btn_back_favoritos"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/white"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="@id/header_background_favoritos"
        app:layout_constraintBottom_toBottomOf="@id/header_background_favoritos"
        app:layout_constraintStart_toStartOf="@id/header_background_favoritos" />

    <!-- Header Title -->
    <TextView
        android:id="@+id/txt_title_favoritos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_favoritos"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/header_background_favoritos"
        app:layout_constraintBottom_toBottomOf="@id/header_background_favoritos"
        app:layout_constraintStart_toStartOf="@id/header_background_favoritos"
        app:layout_constraintEnd_toEndOf="@id/header_background_favoritos" />

    <!-- Search Icon -->
    <ImageView
        android:id="@+id/img_search_favoritos"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_search"
        app:tint="@color/white"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="@id/header_background_favoritos"
        app:layout_constraintBottom_toBottomOf="@id/header_background_favoritos"
        app:layout_constraintEnd_toEndOf="@id/header_background_favoritos" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/header_background_favoritos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/favorites_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="16dp" />

        <TextView
            android:id="@+id/favorites_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/feed_retry"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/favorites_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
