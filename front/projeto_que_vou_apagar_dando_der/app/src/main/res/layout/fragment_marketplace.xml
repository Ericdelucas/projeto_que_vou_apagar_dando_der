<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/marketplace_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Header Background -->
    <View
        android:id="@+id/header_background"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_red_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header Back Button -->
    <ImageView
        android:id="@+id/btn_back_marketplace"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/white"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="@id/header_background"
        app:layout_constraintBottom_toBottomOf="@id/header_background"
        app:layout_constraintStart_toStartOf="@id/header_background" />

    <!-- Header Title -->
    <TextView
        android:id="@+id/txt_title_marketplace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_marketplace"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/header_background"
        app:layout_constraintBottom_toBottomOf="@id/header_background"
        app:layout_constraintStart_toStartOf="@id/header_background"
        app:layout_constraintEnd_toEndOf="@id/header_background" />

    <!-- Header Store Icon -->
    <ImageView
        android:id="@+id/img_store_marketplace"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_store"
        app:tint="@color/white"
        android:contentDescription="@string/title_marketplace"
        app:layout_constraintTop_toTopOf="@id/header_background"
        app:layout_constraintBottom_toBottomOf="@id/header_background"
        app:layout_constraintEnd_toEndOf="@id/header_background" />

    <!-- Filter Pill 1: Tipage: Modelo -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/filter_pill_1"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_red_pill"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/header_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/filter_pill_2">

        <TextView
            android:id="@+id/txt_tipage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/tipage_modelo"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/img_arrow_1" 
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/img_arrow_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/white"
            android:contentDescription="@string/tipage_modelo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/txt_tipage"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Filter Pill 2: Local: SP -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/filter_pill_2"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_red_pill"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="@id/filter_pill_1"
        app:layout_constraintBottom_toBottomOf="@id/filter_pill_1"
        app:layout_constraintStart_toEndOf="@id/filter_pill_1"
        app:layout_constraintEnd_toStartOf="@id/btn_chat_marketplace"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/txt_local"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/marketplace_location"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/img_arrow_2" 
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/img_arrow_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/white"
            android:contentDescription="@string/marketplace_location"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/txt_local"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Chat Button -->
    <ImageView
        android:id="@+id/btn_chat_marketplace"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_chat"
        app:tint="?attr/colorOnSurface"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="@id/filter_pill_1"
        app:layout_constraintBottom_toBottomOf="@id/filter_pill_1"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Filter Pill 3: Categoria: Ano -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/filter_pill_3"
        android:clickable="true"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_red_pill"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/filter_pill_1"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/txt_categoria"
            android:maxWidth="220dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categoria_ano"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/img_arrow_3" />

        <ImageView
            android:id="@+id/img_arrow_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/white"
            android:contentDescription="@string/categoria_ano"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/txt_categoria"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Divider Line -->
    <View
        android:id="@+id/divider_filter"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintTop_toBottomOf="@id/filter_pill_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lista real: mantém o cabeçalho e os filtros do desenho. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/divider_filter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/marketplace_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="16dp" />

        <TextView
            android:id="@+id/marketplace_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/feed_retry"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/products_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:clipToPadding="false" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
