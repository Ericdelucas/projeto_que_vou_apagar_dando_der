<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_login">

    <fragment
        android:id="@+id/nav_login"
        android:name="com.example.app.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_login"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.app.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_product"
            app:destination="@id/nav_product_details" />
    </fragment>

    <fragment
        android:id="@+id/nav_product_details"
        android:name="com.example.app.ProductDetailsFragment"
        android:label="@string/product_details"
        tools:layout="@layout/fragment_product_details">
        <argument android:name="product_id" app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/nav_marketplace"
        android:name="com.example.app.MarketplaceFragment"
        android:label="@string/title_marketplace"
        tools:layout="@layout/fragment_marketplace">
        <action
            android:id="@+id/action_marketplace_to_product"
            app:destination="@id/nav_product_details" />
    </fragment>

    <fragment
        android:id="@+id/nav_vender"
        android:name="com.example.app.VenderFragment"
        android:label="@string/title_vender"
        tools:layout="@layout/fragment_vender" />

    <fragment
        android:id="@+id/nav_users"
        android:name="com.example.app.UsersFragment"
        android:label="@string/title_usuarios"
        tools:layout="@layout/fragment_users">
        <action android:id="@+id/action_users_to_profile" app:destination="@id/nav_user_profile" />
    </fragment>

    <fragment android:id="@+id/nav_user_profile" android:name="com.example.app.PerfilFragment"
        android:label="@string/title_perfil" tools:layout="@layout/fragment_perfil">
        <argument android:name="userId" app:argType="integer" />
        <deepLink app:uri="skippecas://users/{userId}" />
    </fragment>

    <fragment
        android:id="@+id/nav_perfil"
        android:name="com.example.app.PerfilFragment"
        android:label="@string/title_perfil"
        tools:layout="@layout/fragment_perfil" />

    <fragment
        android:id="@+id/nav_configuracoes"
        android:name="com.example.app.ConfiguracoesFragment"
        android:label="@string/title_configuracoes"
        tools:layout="@layout/fragment_configuracoes">

        <action
            android:id="@+id/action_nav_configuracoes_to_favoritosFragment"
            app:destination="@id/favoritosFragment" />
    </fragment>

    <fragment
        android:id="@+id/favoritosFragment"
        android:name="com.example.app.FavoritosFragment"
        android:label="@string/title_favoritos"
        tools:layout="@layout/fragment_favoritos">
        <action
            android:id="@+id/action_favorites_to_product"
            app:destination="@id/nav_product_details" />
    </fragment>

    <fragment android:id="@+id/nav_bloqueados" android:name="com.example.app.BloqueadosFragment"
        android:label="@string/bloqueados" tools:layout="@layout/fragment_bloqueados" />
</navigation>
