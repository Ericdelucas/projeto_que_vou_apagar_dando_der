PORT=10000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=skippecas
DB_PASSWORD=
DB_NAME=skian_db
# Configure um segredo longo e aleatório antes de executar a API.
JWT_SECRET=

# auto: tenta MySQL e usa SQLite em memória em falhas de conectividade.
# memory: demonstração sem tentar MySQL. mysql: banco obrigatório, sem fallback.
# Padrão: auto em qualquer ambiente. Use mysql para exigir persistência.
# DB_MODE=auto
